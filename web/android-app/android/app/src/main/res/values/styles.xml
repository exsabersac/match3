<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 应用主题（深色，游戏全屏画布，不需要 ActionBar） -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/game_bg</item>
        <item name="colorPrimaryDark">@color/game_bg</item>
        <item name="colorAccent">#FFD24A</item>
        <item name="android:windowBackground">@color/game_bg</item>
    </style>

    <!-- BridgeActivity 在 onCreate 里切到这个主题。窗口底色设成游戏背景色：
         旧 WebView（< 140）时 Capacitor 用 padding 把 WebView 让出系统栏 / 刘海，留白处露出的就是它 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/game_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- 启动主题（androidx core-splashscreen） -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/game_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
