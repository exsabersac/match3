-- 独立于仓库根目录 stack 工程的 cabal 工程，只用于 wasm32-wasi-cabal 构建网页版。
packages: .

-- 与根目录原生 stack.yaml（GHC 9.14.1：lts-24.60 + compiler: ghc-9.14.1，extra-deps 钉 random-1.2.1.1 / splitmix-0.1.0.5）
-- 保持完全相同的随机数实现（同种子 → 同开局盘面）；两边必须同步修改
constraints: random ==1.2.1.1, splitmix ==0.1.0.5

-- splitmix-0.1.0.5 在 Hackage 上的 base 上界是 <4.21（GHC 9.14 带 base-4.22），
-- 算法本身不依赖新 base 特性，这里只放宽这一个上界。
allow-newer: splitmix:base

-- 警告即错误：只对本包 match3-web（web/hs 与它直接编译的 ../src、../app/pure 模块）生效，
-- 依赖包（random、splitmix 等）的警告不受影响。本包的 ghc-options 已开 -Wall，因此自家代码必须 0 警告才能构建通过。
package match3-web
  ghc-options: -Werror
